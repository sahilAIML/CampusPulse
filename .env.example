# CampusPulse Data Access Layer Mode
# Set to 'mock' for local in-memory seed data, or 'supabase' for live Postgres DB
DATA_MODE=mock
NEXT_PUBLIC_DATA_MODE=mock

# Supabase Credentials (Read from environment, never hardcoded)
SUPABASE_URL=https://placeholder-project.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key-for-development
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-for-development
